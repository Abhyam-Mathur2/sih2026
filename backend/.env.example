# ============================================================
# BMIM – Bharat Material Intelligence Network
# Backend Environment Variables
# ============================================================
# HOW TO USE:
#   Windows:   copy .env.example .env
#   Linux/Mac: cp .env.example .env
# Then fill in your actual Supabase values below.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# -----------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
# Choose "URI" and select mode:
#   - "Session"  → use psycopg driver  (postgresql+psycopg://...)
#   - "Transaction" → also psycopg, for pooled connections (port 6543)
#
# For Alembic migrations and async FastAPI use:
#   Async URL  (asyncpg driver) – used by FastAPI at runtime
#   Sync  URL  (psycopg driver) – used by Alembic for migrations
#
# IMPORTANT: Replace [PASSWORD] with your Supabase database password.
# The password is set when you create the project (Project Settings → Database).
#
# Example (Direct connection, recommended for local dev):
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres

# -----------------------------------------------------------
# SUPABASE API KEYS
# -----------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
# Example: https://abcdefghijklmn.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon/public key – safe for client-side use, used for Storage public reads
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key – BACKEND ONLY, NEVER expose to frontend
# Used for Storage bucket operations (upload, list, delete)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Storage bucket name for CSV uploads (created automatically by FastAPI on startup)
SUPABASE_STORAGE_BUCKET=material-uploads

# -----------------------------------------------------------
# JWT / SECURITY
# -----------------------------------------------------------
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------
# BACKEND SERVER
# -----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
ENVIRONMENT=development

# CORS – allow the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------
# AI / MATCHING ENGINE
# -----------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CANDIDATE_TOP_K=20

# Scoring weights (must sum to 1.0)
WEIGHT_SEMANTIC=0.35
WEIGHT_FUZZY=0.20
WEIGHT_ATTRIBUTE=0.25
WEIGHT_TECHNICAL=0.20

# Classification thresholds (0-100 scale)
THRESHOLD_IDENTICAL=95
THRESHOLD_NEAR_DUPLICATE=80
THRESHOLD_FUNCTIONAL=60

# -----------------------------------------------------------
# VECTOR BACKEND
# -----------------------------------------------------------
# pgvector  – Supabase PostgreSQL includes pgvector by default.
#             Use this for production-quality semantic search.
# local     – Python-based cosine similarity (no pgvector needed).
#             Use this only if you cannot connect to Supabase.
VECTOR_BACKEND=pgvector

# -----------------------------------------------------------
# STORAGE BACKEND
# -----------------------------------------------------------
# supabase – Upload CSV files to Supabase Storage (recommended)
# local    – Save files to the local filesystem (fallback)
STORAGE_BACKEND=supabase

# Local upload directory (used when STORAGE_BACKEND=local)
# Leave blank to use the OS temp directory automatically.
# UPLOAD_DIR=

# -----------------------------------------------------------
# MODEL CACHE
# -----------------------------------------------------------
# Local directory for caching Sentence Transformer model weights.
# Leave blank to use the default (~/.bmim_cache).
# MODEL_CACHE_DIR=

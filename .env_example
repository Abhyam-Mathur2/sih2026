# ============================================================
# SANGAM – Environment Configuration Template
# Standardized AI-driven National Gateway for Aggregated Materials
# ============================================================
# Copy this file to .env and fill in your actual credentials:
#   copy .env_example .env      (Windows)
#   cp .env_example .env        (Linux/macOS)
# ============================================================

# Supabase configuration
SUPABASE_PROJECT_ID=your_project_ref_here
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database connection (replace [YOUR-PASSWORD] and [HOST] with your Supabase DB details)
# Session pooler or direct connection:
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[HOST]:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[HOST]:5432/postgres

# Application secrets (keep these private)
JWT_SECRET_KEY=generate_a_long_random_jwt_secret_key_here
SECRET_KEY=generate_a_long_random_general_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# AI Vector Storage Backend: pgvector (recommended) or local
VECTOR_BACKEND=pgvector

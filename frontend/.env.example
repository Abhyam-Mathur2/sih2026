# ============================================================
# BMIM Frontend – Environment Variables
# ============================================================
# Copy this file to frontend/.env:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
# ============================================================

# API base URL – must match where the FastAPI backend is running.
# For local development this is always http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
